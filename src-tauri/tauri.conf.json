{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Browsphere",
    "version":  "0.1.0",
    "identifier":  "browsphere",
    "build":  {
                  "frontendDist":  "../ui/public"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Browsphere",
                                    "width":  1360,
                                    "height":  880,
                                    "minWidth":  960,
                                    "minHeight":  640,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "transparent":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://github.com/KUNDURUHIMANEESHREDDY/browsphere/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  ""
                                }
                }
}